HTTP_ADDRESS=127.0.0.1:8080
DATABASE_URL=postgres://aegispolicy:local-development-only@127.0.0.1:5432/aegispolicy?sslmode=disable
OPA_URL=http://127.0.0.1:8181
MAX_DB_CONNECTIONS=10
JWT_ISSUER=https://identity.example
JWT_AUDIENCE=aegispolicy
JWT_ALGORITHM=RS256
JWKS_URL=https://identity.example/.well-known/jwks.json
JWT_CLOCK_SKEW=30s
JWKS_TIMEOUT=2s
JWKS_CACHE_TTL=5m
